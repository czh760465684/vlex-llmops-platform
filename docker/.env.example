# ============================================================
# VlexLLMOps 部署环境变量模板
# 复制为同目录 .env 并填入真实值:  cp .env.example .env
# docker compose 会自动读取 docker/.env 中的变量
# ============================================================

# ---- 基础服务 ----
# PostgreSQL 密码（默认 postgres，生产环境务必修改）
POSTGRES_PASSWORD=postgres

# Redis 密码
REDIS_PASSWORD=your-redis-password

# ---- 应用服务 (llmops-api / llmops-celery) ----
# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET_KEY=your-jwt-secret

# 服务对外地址（影响 OAuth 回调等）
SERVICE_IP=your-server-ip
SERVICE_API_PREFIX=https://your-domain/api

# Weaviate 向量库 API Key（与 AUTHENTICATION_APIKEY_ALLOWED_KEYS 保持一致）
WEAVIATE_API_KEY=your-weaviate-api-key
# Weaviate 管理员用户邮箱
ADMIN_USER_EMAIL=admin@example.com

# ---- 腾讯云 COS 对象存储 ----
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-cos-bucket

# ---- 模型服务商 ----
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
GAODE_API_KEY=your-gaode-key
SERPER_API_KEY=your-serper-key

# ---- GitHub OAuth（可选）----
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://your-domain/auth/authorize/github
